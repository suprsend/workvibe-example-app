# ─────────────────────────────────────────────────────────────────────────────
# WorkVibe — environment variables
#
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# Values come from your SuprSend dashboard (https://app.suprsend.com) and OpenAI.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (AI template + workflow authoring) ────────────────────────────────
OPENAI_API_KEY=sk-...

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of this app (e.g. http://localhost:3000 in dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SuprSend (account-wide) ──────────────────────────────────────────────────
# Service Token authorizes the management API (templates, workflows, schema).
# One token for the whole account. Found under Developers → API Keys.
SUPRSEND_SERVICE_TOKEN=
# API hosts (defaults shown; override only for a private/region-specific cluster).
SUPRSEND_MGMNT_URL=https://management-api.suprsend.com
SUPRSEND_HOST=https://hub.suprsend.com

# ─────────────────────────────────────────────────────────────────────────────
# PER-WORKSPACE KEYS  (the important convention — read this)
#
# WorkVibe is multi-tenant: each workspace has its own SuprSend workspace.
# For every workspace slug listed in `lib/workspaces.ts`, the app reads env vars
# whose prefix is derived from the slug:
#
#     slug "workvibe-uber"  ->  prefix "SUPRSEND_WORKVIBE_UBER"
#     (uppercase, dashes -> underscores)
#
# So if you add a workspace with slug "acme-corp", you must add the same set of
# vars with prefix SUPRSEND_ACME_CORP (and NEXT_PUBLIC_SUPRSEND_ACME_CORP).
#
# Per workspace you need:
#   <PREFIX>_WORKSPACE_KEY          server workspace key   (Developers → API Keys)
#   <PREFIX>_WORKSPACE_SECRET       server workspace secret
#   <PREFIX>_SIGNING_KEY_ID         embedded-editor signing key id  (signing_key_*)
#   <PREFIX>_SIGNING_KEY_B64        embedded-editor signing key, base64-encoded
#   <PREFIX>_SLACK_WEBHOOK          (optional) Slack incoming-webhook URL
#   NEXT_PUBLIC_<PREFIX>_PUBLIC_KEY      public key (browser SDK)
#   NEXT_PUBLIC_<PREFIX>_WORKSPACE_KEY   public workspace key (browser SDK)
#
# The two example workspaces shipped in lib/workspaces.ts are below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Workspace: workvibe-uber ─────────────────────────────────────────────────
SUPRSEND_WORKVIBE_UBER_WORKSPACE_KEY=
SUPRSEND_WORKVIBE_UBER_WORKSPACE_SECRET=
SUPRSEND_WORKVIBE_UBER_SIGNING_KEY_ID=
SUPRSEND_WORKVIBE_UBER_SIGNING_KEY_B64=
SUPRSEND_WORKVIBE_UBER_SLACK_WEBHOOK=
NEXT_PUBLIC_SUPRSEND_WORKVIBE_UBER_PUBLIC_KEY=
NEXT_PUBLIC_SUPRSEND_WORKVIBE_UBER_WORKSPACE_KEY=

# ── Workspace: workvibe-spacex ───────────────────────────────────────────────
SUPRSEND_WORKVIBE_SPACEX_WORKSPACE_KEY=
SUPRSEND_WORKVIBE_SPACEX_WORKSPACE_SECRET=
SUPRSEND_WORKVIBE_SPACEX_SIGNING_KEY_ID=
SUPRSEND_WORKVIBE_SPACEX_SIGNING_KEY_B64=
SUPRSEND_WORKVIBE_SPACEX_SLACK_WEBHOOK=
NEXT_PUBLIC_SUPRSEND_WORKVIBE_SPACEX_PUBLIC_KEY=
NEXT_PUBLIC_SUPRSEND_WORKVIBE_SPACEX_WORKSPACE_KEY=
